# ─────────────────────────────────────────────────────────────
#  Copia a .env y edita.  .env NUNCA se commitea.
# ─────────────────────────────────────────────────────────────

# ═══ MODO ═══
# collect | paper | live
MODE=collect
# live exige ADEMÁS esta variable en "yes". Es a propósito.
I_UNDERSTAND_LIVE=no

# ═══ Polymarket ═══
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
CLOB_WS=wss://ws-subscriptions-clob.polymarket.com/ws
CHAIN_ID=137

# signature_type: 0=EOA  1=Email/Magic  2=Browser proxy
SIGNATURE_TYPE=1

# ── Wallet PILOTO A (LLM) ── dedicada, fondos mínimos
PILOT_A_PRIVATE_KEY=
PILOT_A_FUNDER=

# ── Wallet PILOTO B (complete sets) ── dedicada, SEPARADA de A
PILOT_B_PRIVATE_KEY=
PILOT_B_FUNDER=

# ═══ Base de datos ═══
# Local (docker compose) o el connection string de Neon:
#   postgresql://USER:PASS@ep-xxxx.region.aws.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql://trade:trade@localhost:5432/mcptrade

# Solo si el bot va a gestionar branches/proyectos por su cuenta.
# Para leer y escribir datos NO se necesita: eso va por DATABASE_URL.
NEON_API_KEY=

# ═══ LLM (solo piloto A) ═══
ANTHROPIC_API_KEY=
# claude-opus-5 ($5/$25 por 1M tok). A 6 decisiones/día son centavos:
# el costo del estratega NO es donde vas a perder plata.
STRATEGIST_MODEL=claude-opus-5
STRATEGIST_INTERVAL_MIN=240

# ═══ Alertas ═══
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ═════════════════════════════════════════════════════════════
#  LÍMITES DE RIESGO  —  el LLM NO puede leer ni modificar esto
#  Cámbialos solo tú, a mano, con el bot detenido.
# ═════════════════════════════════════════════════════════════

# ── PILOTO A ──
RISK_A_MAX_ORDER_USD=5
RISK_A_MAX_POSITION_USD=25
RISK_A_MAX_GROSS_EXPOSURE_USD=50
RISK_A_MAX_DAILY_LOSS_USD=10
RISK_A_MAX_ORDERS_PER_MIN=6
RISK_A_MAX_OPEN_ORDERS=10
RISK_A_MAX_PRICE_DEVIATION=0.03
RISK_A_MIN_PRICE=0.02
RISK_A_MAX_PRICE=0.98

# ── PILOTO B ──
RISK_B_MAX_ORDER_USD=10
RISK_B_MAX_POSITION_USD=60
RISK_B_MAX_GROSS_EXPOSURE_USD=120
RISK_B_MAX_DAILY_LOSS_USD=15
RISK_B_MAX_ORDERS_PER_MIN=60
RISK_B_MAX_OPEN_ORDERS=40
RISK_B_MAX_PRICE_DEVIATION=0.05
RISK_B_MIN_PRICE=0.02
RISK_B_MAX_PRICE=0.98

# Umbral del piloto B: solo arma set si Up+Down <= esto
SETS_MAX_COMBINED_COST=0.988
# Máximo desbalance de inventario (shares) antes de forzar pareo
SETS_MAX_IMBALANCE_SHARES=50
# Whitelist de slugs de mercado (vacío = ninguno; NUNCA dejes "todos")
SETS_MARKET_SLUGS=

# ═══ Watchdog ═══
# si no llegan datos del WS en N segundos -> flatten + alerta
STALE_DATA_SECONDS=30
