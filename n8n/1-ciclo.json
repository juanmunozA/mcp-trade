      },
      "name": "Operar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        360
      ],
      "id": "operar",
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Une la decisión de la política con lo que devolvió /trade.\nconst p = $('Política · ¿operar?').item.json;\nreturn [{ json: { ...p, ...($json.body ?? $json) } }];"
      },
      "name": "Anotar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        360
      ],
      "id": "anotar"
    },
    {
      "parameters": {
        "jsCode": "// Un item por mercado. Distingue tres cosas que antes se confundían:\n// lo que el AGENTE descartó, lo que la POLÍTICA descartó, y lo que operó.\nconst rs = $input.all().map(i => i.json);\nconst ordenes  = rs.filter(r => r.opero);\nconst porAgente = rs.filter(r => !r.operar && (r.vetado || !r.ok));\nconst porPolitica = rs.filter(r => !r.operar && r.ok && !r.vetado);\nconst rechazadas = rs.filter(r => r.operar && !r.opero);\n\nconst razones = {};\nfor (const r of rs) if (!r.operar) razones[r.razon] = (razones[r.razon] || 0) + 1;\n\nconst linea = r => (r.opero ? '🟢 ' : r.vetado ? '🛑 ' : '· ')\n  + `<b>${(r.pregunta || r.slug || '').slice(0, 68)}</b>\\n`\n  + (r.opero\n      ? `   ${r.accion} $${r.size_usd} · p=${r.p} vs ${r.precio_mercado} · edge ${r.edge}`\n      : `   ${r.razon || r.motivo || ''}`.slice(0, 110));\n\nconst destacados = rs.filter(r => r.opero || r.vetado);\n\nreturn [{ json: {\n  vistos: rs.length,\n  ordenes: ordenes.length,\n  freno_el_agente: porAgente.length,\n  freno_la_politica: porPolitica.length,\n  freno_el_kernel: rechazadas.length,\n  razones,\n  costo_usd: +rs.reduce((a, r) => a + (r.costo_usd || 0), 0).toFixed(6),\n  hay_algo: destacados.length > 0,\n  texto: `<b>Ciclo</b> · ${rs.length} mercados · ${ordenes.length} órdenes\\n`\n       + `frenó: agente ${porAgente.length} · política ${porPolitica.length} · `\n       + `kernel ${rechazadas.length}\\n`\n       + Object.entries(razones).map(([k, v]) => `${k}: ${v}`).join(' · ')\n       + (destacados.length ? '\\n\\n' + destacados.slice(0, 8).map(linea).join('\\n') : ''),\n} }];"
      },
      "name": "Resumir ciclo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        120
      ],
      "id": "resumir-ciclo"
    },
