            }
          }
        }
      },
      "name": "Pedir candidatos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -640,
        380
      ],
      "id": "pedir-candidatos"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.n }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "¿Hay candidatos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -420,
        380
      ],
      "id": "¿hay-candidatos?"
    },
    {
      "parameters": {
        "jsCode": "// POLÍTICA: qué mercados vale la pena analizar. Editable sin tocar código.\nconst cs = $json.body.candidatos || [];\n\nconst SIN_ALPHA = ['crypto'];   // PolyBench: miscalibración severa ahí\nconst DIAS_MIN  = 2;            // resolver mañana no da tiempo a nada\nconst TOPE      = 8;            // cuántos analizar por ciclo\n\nconst pasan = cs\n  .filter(c => !SIN_ALPHA.includes(c.categoria))\n  .filter(c => (c.dias ?? 999) >= DIAS_MIN)\n  .sort((a, b) => b.puntaje - a.puntaje)\n  .slice(0, TOPE);\n\nreturn pasan.map(c => ({ json: c }));"
      },
      "name": "Política · qué mirar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        300
      ],
      "id": "política-·-qué-mirar"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {
          "reset": false
        }
      },
      "name": "Por mercado",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        20,
        300
      ],
      "id": "por-mercado"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_URL || 'http://agent:10000' }}/forecast",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 900000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ slug: $json.slug }) }}"
      },
      "name": "Pronosticar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        440
      ],
      "id": "pronosticar",
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// POLÍTICA: con el pronóstico en la mano, ¿vale la pena operarlo?\n// Esto es lo que antes estaba enterrado en Python.\n//\n// Los tres vetos y el risk kernel NO están aquí: los aplica el agente\n// siempre. Son seguridad, no política — apagarlos no debe ser editable.\nconst f = $json.body ?? $json;\n\nconst DIVERGENCIA_MIN = 0.06;   // menos que esto no paga el spread\nconst SOLO_ESCALADOS  = false;  // true = exige segunda opinión del ensemble\n\nlet operar = true, razon = 'pasa';\nif (!f.ok)                            { operar = false; razon = f.motivo || f.parado_en || 'análisis falló'; }\nelse if (f.vetado)                    { operar = false; razon = 'vetado por el agente'; }\nelse if (f.divergencia == null)        { operar = false; razon = 'sin divergencia'; }\nelse if (f.divergencia < DIVERGENCIA_MIN) { operar = false; razon = `divergencia ${f.divergencia} < ${DIVERGENCIA_MIN}`; }\nelse if (SOLO_ESCALADOS && !f.escalado)   { operar = false; razon = 'sin segunda opinión'; }\n\nreturn [{ json: { ...f, operar, razon } }];"
      },
      "name": "Política · ¿operar?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        440
      ],
      "id": "política-·-¿operar?"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.operar }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "¿Operar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        440
      ],
      "id": "¿operar?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_URL || 'http://agent:10000' }}/trade",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
