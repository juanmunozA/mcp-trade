{
  "name": "1 · Ciclo de pronóstico (fan-out por mercado)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 4
            }
          ]
        }
      },
      "name": "Cada 4 horas",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -640,
        300
      ],
      "id": "cada-4-horas"
    },
    {
      "parameters": {},
      "name": "Disparo manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -640,
        460
      ],
      "id": "disparo-manual"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://agent:10000/candidates",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "name": "Pedir candidatos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -420,
        380
      ],
      "id": "pedir-candidatos"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.body.n }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "¿Hay candidatos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -200,
        380
      ],
      "id": "¿hay-candidatos?"
    },
    {
      "parameters": {
        "fieldToSplitOut": "body.candidatos",
        "options": {}
      },
      "name": "Un item por mercado",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        20,
        300
      ],
      "id": "un-item-por-mercado"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {
          "reset": false
        }
      },
      "name": "Por mercado",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        240,
        300
      ],
      "id": "por-mercado"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://agent:10000/market",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 900000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ slug: $json.slug }) }}"
      },
      "name": "Pronosticar mercado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        420
      ],
      "id": "pronosticar-mercado",
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Cada item es el resultado de UN mercado. Aquí se arma el desglose que\n// antes solo existía en los logs del contenedor.\nconst rs = $input.all().map(i => i.json.body ?? i.json);\nconst ok = rs.filter(r => r && r.corrido);\nconst ordenes = ok.filter(r => r.opero);\nconst porPaso = {};\nfor (const r of ok) porPaso[r.parado_en || '?'] = (porPaso[r.parado_en || '?'] || 0) + 1;\n\nconst linea = r => `${r.opero ? '🟢' : (r.parado_en === 'veto' ? '🛑' : '·')} `\n  + `<b>${(r.pregunta || r.slug || '').slice(0, 70)}</b>\\n`\n  + `   ${r.parado_en}${r.motivo ? ' — ' + String(r.motivo).slice(0, 90) : ''}`\n  + (r.opero ? `\\n   ${r.accion} $${r.size_usd} · p=${r.p_pronostico} vs ${r.precio_mercado} · edge ${r.edge}` : '');\n\nconst destacados = ok.filter(r => r.opero || r.parado_en === 'veto');\n\nreturn [{ json: {\n  vistos: rs.length,\n  corridos: ok.length,\n  ordenes: ordenes.length,\n  escalados: ok.filter(r => r.escalado).length,\n  desglose: porPaso,\n  costo_usd: +ok.reduce((a, r) => a + (r.costo_usd || 0), 0).toFixed(6),\n  hay_algo: destacados.length > 0,\n  texto: `<b>Ciclo</b> · ${ok.length}/${rs.length} mercados · `\n       + `${ordenes.length} órdenes\\n`\n       + Object.entries(porPaso).map(([k, v]) => `${k}:${v}`).join(' · ')\n       + (destacados.length ? '\\n\\n' + destacados.slice(0, 8).map(linea).join('\\n') : ''),\n} }];"
      },
      "name": "Resumir ciclo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        180
      ],
      "id": "resumir-ciclo"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.hay_algo }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "name": "¿Algo que contar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        680,
        180
      ],
      "id": "¿algo-que-contar?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({chat_id: $env.TELEGRAM_CHAT_ID, text: $json.texto, parse_mode: 'HTML'}) }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "name": "Avisar ciclo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        180
      ],
      "id": "avisar-ciclo"
    },
    {
      "parameters": {
        "jsCode": "return [{json:{nota: $json.body.nota || 'sin candidatos'}}];"
      },
      "name": "Sin candidatos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        500
      ],
      "id": "sin-candidatos"
    }
  ],
